{
  "name": "spec-studio-relay",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted relay for Spec Studio: a remote MCP server with a Temporal mirror of each spec, messages and attachments.",
  "repository": {
    "type": "git",
    "url": "https://github.com/spec-studio-app/spec-studio-relay.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js serve",
    "test": "npm run build && node --test --test-timeout=180000 dist/test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/common": "^1.26.0",
    "@temporalio/proto": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "long": "^5.3.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.26.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  },
  "bin": {
    "relay": "dist/src/cli.js"
  }
}
